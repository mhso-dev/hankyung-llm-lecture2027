+            labels += re.findall(r'[\[\(\{]+([^\[\]\(\)\{\}"|]+)[\]\)\}]+', plain)
+            bare = re.match(r'subgraph\s+([^\s\["]+)\s*$', line)
+            labels += [bare.group(1)] if bare else []
